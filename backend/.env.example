# UCMS Analytics API — environment template
# Copy to `.env` (same folder) and fill real values — NEVER commit .env.
# Ask the team lead for the values (Render ▸ service `capstone` ▸ Environment).

# Supabase project the API reads/writes (backup project for the re-demo)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Gate for every /portal, /forecast, /analytics, /charts, /risk route
UCMS_API_KEY=long-random-string

# Origins allowed to call this API from a browser (comma-separated).
# Defaults already cover local Vite dev + the deployed Pages site.
UCMS_CORS_ORIGINS=http://localhost:5173,https://ucms-defense.pages.dev
