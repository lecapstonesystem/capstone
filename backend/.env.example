# Copy to backend/.env (gitignored). NEVER commit real values.
# Data locations (defaults already point at ../data and ../outputs).
UCMS_DATA_DIR=../data
UCMS_OUTPUT_DIR=../outputs
# Shared secret the admin portal sends as X-API-Key header.
UCMS_API_KEY=change-me-long-random-string
# Frontend origin(s) allowed to call this API in browsers (comma-separated).
# Without this, Vite (:5173) gets blocked by CORS and nothing connects.
UCMS_CORS_ORIGINS=http://localhost:5173
# Phase 2 (service_role write-through) — server-side ONLY, never the frontend:
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# With both set, the backend reads LIVE Supabase rows (store.py) instead of
# CSVs, and scripts/seed_supabase.py --apply can populate them. service_role
# bypasses ALL RLS: it must never appear in logs, errors, or git.
